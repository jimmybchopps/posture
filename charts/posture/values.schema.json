{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "posture values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mesh": {
      "description": "The service mesh in use.",
      "type": "string",
      "enum": [
        "none",
        "istio"
      ]
    },
    "trustDomain": {
      "description": "The mesh trust domain, used to build workload identities.",
      "type": "string",
      "minLength": 1
    },
    "namePrefix": {
      "description": "Optional prefix for every generated object name.",
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "networkPolicy": {
      "description": "NetworkPolicies per direction; false renders none for that direction (troubleshooting only).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingress": {
          "type": "boolean"
        },
        "egress": {
          "type": "boolean"
        }
      }
    },
    "authorization": {
      "description": "The mesh's authorization policies, generated from the ingress rules. Used when mesh isn't none; false renders none (troubleshooting only).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "mtls": {
      "description": "The namespace's mTLS mode, and workloads that also accept plaintext on listed ports. Used when mesh isn't none.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "STRICT, PERMISSIVE, or inherit (render nothing; the mesh-wide setting applies). There is no DISABLE.",
          "type": "string",
          "enum": ["STRICT", "PERMISSIVE", "inherit"]
        },
        "exclusions": {
          "description": "Workload in this namespace -> ports that also accept plaintext (PERMISSIVE); only with mode STRICT.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/nameNotAny"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/exclusionPorts"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "$ref": "#/definitions/enabled"
                  },
                  "selector": {
                    "$ref": "#/definitions/selector"
                  },
                  "ports": {
                    "$ref": "#/definitions/exclusionPorts"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "profiles": {
      "description": "Built-in profiles. Listing one turns it on; enabled: false keeps it, off.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "istio-system": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/definitions/enabled"
            },
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "apiServerCidrs": {
                  "description": "Where the API server calls istiod's webhooks from (required).",
                  "$ref": "#/definitions/cidrs"
                }
              }
            }
          }
        },
        "istio-ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/definitions/enabled"
            },
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ports": {
                  "description": "The gateway's listener ports (default 443, 80).",
                  "$ref": "#/definitions/ports"
                },
                "clientCidrs": {
                  "description": "Where clients connect from (default the private ranges).",
                  "$ref": "#/definitions/cidrs"
                }
              }
            }
          }
        },
        "istio-egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/definitions/enabled"
            },
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ports": {
                  "description": "The ports the waypoint forwards to (default 443, 80).",
                  "$ref": "#/definitions/ports"
                }
              }
            }
          }
        }
      }
    },
    "meshMember": {
      "description": "Whether this namespace's pods are in the mesh data plane (default true). false: NetworkPolicies and exceptions only.",
      "type": "boolean"
    },
    "allowSameNamespace": {
      "description": "Allow all traffic between pods in this namespace.",
      "type": "boolean"
    },
    "allowDNS": {
      "description": "Allow egress from every pod to the dns destination.",
      "type": "boolean"
    },
    "policyExceptions": {
      "description": "Render the posture-exceptions PolicyExceptions object (even with no exceptions). false only on clusters without the PolicyExceptions CRD; exceptions then fail.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "exceptions": {
      "description": "Admission-policy exceptions: workload in this namespace (matched by label) -> the policies it's excepted from.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/nameNotAny"
      },
      "additionalProperties": {
        "$ref": "#/definitions/exception"
      }
    },
    "sources": {
      "description": "Overrides of predefined sources, and custom sources.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/nameNotAny"
      },
      "additionalProperties": {
        "$ref": "#/definitions/source"
      }
    },
    "destinations": {
      "description": "Overrides of predefined destinations, and custom destinations.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/nameNotAny"
      },
      "additionalProperties": {
        "$ref": "#/definitions/destination"
      }
    },
    "ingress": {
      "description": "Ingress rules, keyed by target workload.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/name"
      },
      "additionalProperties": {
        "$ref": "#/definitions/ingressRule"
      }
    },
    "egress": {
      "description": "Egress rules, keyed by source workload; allowedHosts is reserved (egress to hostnames).",
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "#/definitions/name"
          },
          {
            "const": "allowedHosts"
          }
        ]
      },
      "properties": {
        "allowedHosts": {
          "$ref": "#/definitions/allowedHosts"
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/egressRule"
      }
    },
    "global": {
      "description": "Helm's global values (set when this chart is a dependency); unused.",
      "type": "object"
    }
  },
  "definitions": {
    "enabled": {
      "description": "Default true. false renders nothing, but the entry is still validated.",
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "nameNotAny": {
      "allOf": [
        {
          "$ref": "#/definitions/name"
        },
        {
          "not": {
            "const": "any"
          }
        }
      ]
    },
    "namespace": {
      "description": "Omitted = this namespace; any = every namespace.",
      "$ref": "#/definitions/name"
    },
    "selector": {
      "type": "string",
      "enum": [
        "name",
        "component",
        "instance",
        "app"
      ]
    },
    "serviceAccount": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
      "not": {
        "const": "any"
      }
    },
    "podSelector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "exception": {
      "description": "Completeness (policies) is checked after profiles are layered in.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "policies": {
          "description": "Policy name -> the exception. Names follow the PolicyExceptions CRD (a DNS label, at most 63 characters).",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "allOf": [
              {
                "$ref": "#/definitions/name"
              },
              {
                "maxLength": 63
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/definitions/policyException"
          }
        }
      }
    },
    "policyException": {
      "description": "Completeness (kind) is checked after profiles are layered in, so { enabled: false } can switch off a profile's exception.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ValidatingAdmissionPolicy",
            "MutatingAdmissionPolicy"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        },
        "expires": {
          "description": "YYYY-MM-DD (UTC). From the day after, the entry is left out at render.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "enabled": {
          "description": "Default true; false keeps the entry in values but exempts nothing.",
          "type": "boolean"
        }
      }
    },
    "exclusionPorts": {
      "description": "Plain port numbers: mTLS settings are per single TCP port (no protocol, no range).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/portNumber"
      }
    },
    "portNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "port": {
      "oneOf": [
        {
          "$ref": "#/definitions/portNumber"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "$ref": "#/definitions/portNumber"
            },
            "endPort": {
              "$ref": "#/definitions/portNumber"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "TCP",
                "UDP",
                "SCTP"
              ]
            }
          }
        }
      ]
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/port"
      }
    },
    "cidr": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"
        },
        {
          "pattern": "^[0-9a-fA-F]{0,4}(:[0-9a-fA-F]{0,4}){2,7}/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$"
        }
      ]
    },
    "cidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/cidr"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr"
            ],
            "properties": {
              "cidr": {
                "$ref": "#/definitions/cidr"
              },
              "except": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/cidr"
                }
              }
            }
          }
        ]
      }
    },
    "workloadPeer": {
      "description": "Completeness (ports) is checked after profiles are layered in, so a partial entry can override or switch off a profile's.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "#/definitions/enabled"
        },
        "namespace": {
          "$ref": "#/definitions/namespace"
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "ports": {
          "$ref": "#/definitions/ports"
        }
      }
    },
    "cidrPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cidrs"
      ],
      "properties": {
        "enabled": {
          "$ref": "#/definitions/enabled"
        },
        "cidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "ports": {
          "$ref": "#/definitions/ports"
        }
      }
    },
    "anyPeer": {
      "description": "Every pod (in the namespace given). No selector or serviceAccount.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "#/definitions/enabled"
        },
        "namespace": {
          "$ref": "#/definitions/namespace"
        },
        "ports": {
          "$ref": "#/definitions/ports"
        }
      }
    },
    "peers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/name"
      },
      "properties": {
        "any": {
          "$ref": "#/definitions/anyPeer"
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/workloadPeer"
          },
          {
            "$ref": "#/definitions/cidrPeer"
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "$ref": "#/definitions/namespace"
        },
        "workload": {
          "description": "Workload name; any = every pod.",
          "$ref": "#/definitions/name"
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "podSelector": {
          "$ref": "#/definitions/podSelector"
        },
        "cidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "$ref": "#/definitions/namespace"
        },
        "workload": {
          "description": "Workload name; any = every pod.",
          "$ref": "#/definitions/name"
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "podSelector": {
          "$ref": "#/definitions/podSelector"
        },
        "cidrs": {
          "$ref": "#/definitions/cidrs"
        },
        "ports": {
          "$ref": "#/definitions/ports"
        }
      }
    },
    "ingressRule": {
      "type": "object",
      "additionalProperties": false,
      "description": "Needs at least one of from or sources, checked after profiles are layered in.",
      "properties": {
        "enabled": {
          "$ref": "#/definitions/enabled"
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "from": {
          "$ref": "#/definitions/peers"
        },
        "sources": {
          "description": "Source name -> the ports on this target: a ports list, or { ports, enabled }.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/nameNotAny"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/ports"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "$ref": "#/definitions/enabled"
                  },
                  "ports": {
                    "$ref": "#/definitions/ports"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "description": "Needs at least one of to or destinations, checked after profiles are layered in.",
      "properties": {
        "enabled": {
          "$ref": "#/definitions/enabled"
        },
        "selector": {
          "$ref": "#/definitions/selector"
        },
        "to": {
          "$ref": "#/definitions/peers"
        },
        "destinations": {
          "description": "Destination name -> {} (ports come from its definition), or { enabled }.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/nameNotAny"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "$ref": "#/definitions/enabled"
              }
            }
          }
        }
      }
    },
    "address": {
      "description": "An IP address or CIDR.",
      "type": "string",
      "anyOf": [
        {
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(3[0-2]|[12]?[0-9]))?$"
        },
        {
          "pattern": "^[0-9a-fA-F]{0,4}(:[0-9a-fA-F]{0,4}){2,7}(/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))?$"
        }
      ]
    },
    "host": {
      "description": "A DNS name; a wildcard only as the leading label (*.example.com).",
      "type": "string",
      "maxLength": 253,
      "pattern": "^(\\*\\.)?([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "allowedHosts": {
      "description": "Hosts outside the cluster this namespace may reach through the egress waypoint (mesh: istio), keyed by entry name. Completeness (hosts or addresses, ports) is checked after profiles are layered in.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/nameNotAny"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "$ref": "#/definitions/enabled"
          },
          "hosts": {
            "description": "DNS names (matched by SNI for TLS, by Host for HTTP).",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/host"
            }
          },
          "addresses": {
            "description": "IP addresses or CIDRs.",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/address"
            }
          },
          "ports": {
            "description": "Plain port numbers: the protocol is the entry's, and ServiceEntry ports have no ranges.",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/portNumber"
            }
          },
          "protocol": {
            "description": "Default TLS. TCP needs addresses.",
            "type": "string",
            "enum": [
              "TLS",
              "HTTP",
              "TCP"
            ]
          },
          "gateway": {
            "description": "The egress waypoint's name; default default.",
            "$ref": "#/definitions/name"
          }
        }
      }
    }
  }
}
