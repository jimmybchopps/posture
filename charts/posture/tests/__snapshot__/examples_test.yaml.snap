        posture.dev/rule: ingress.api.from.x
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-x-to-api
      namespace: example
    spec:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: plain
              podSelector:
                matchLabels:
                  app.kubernetes.io/name: x
          ports:
            - port: 8080
              protocol: TCP
            - port: 8081
              protocol: TCP
            - port: 15008
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/name: api
      policyTypes:
        - Ingress
  13: |
