exceptions:
  1: |
    apiVersion: policy.posture.dev/v1alpha1
    kind: PolicyExceptions
    metadata:
      annotations:
        posture.dev/rule: exceptions
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: posture-exceptions
      namespace: example
    spec:
      exceptions:
        - policy:
            kind: ValidatingAdmissionPolicy
            name: disallow-host-path
          workloads:
            - matchLabels:
                app.kubernetes.io/name: node-agent
              reason: reads /proc from the node
        - policy:
            kind: ValidatingAdmissionPolicy
            name: require-run-as-non-root
          workloads:
            - expires: "2099-12-31"
              matchLabels:
                app.kubernetes.io/instance: legacy
              reason: vendor image runs as root; ticket to rebuild it
        - policy:
            kind: ValidatingAdmissionPolicy
            name: restrict-volume-types
          workloads:
            - matchLabels:
                app.kubernetes.io/name: node-agent
              reason: reads /proc from the node
  2: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.ingress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-ingress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Ingress
  3: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.egress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-egress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Egress
  4: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: allowDNS
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-egress-from-all-to-dns
      namespace: example
    spec:
      egress:
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
          to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: kube-system
              podSelector:
                matchLabels:
                  k8s-app: kube-dns
      podSelector: {}
      policyTypes:
        - Egress
  5: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: allowSameNamespace
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-same-namespace
      namespace: example
    spec:
      egress:
        - to:
            - podSelector: {}
      ingress:
        - from:
            - podSelector: {}
      podSelector: {}
      policyTypes:
        - Ingress
        - Egress
grafana:
  1: |
    apiVersion: policy.posture.dev/v1alpha1
    kind: PolicyExceptions
    metadata:
      annotations:
        posture.dev/rule: exceptions
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: posture-exceptions
      namespace: example
    spec:
      exceptions: []
  2: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.ingress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-ingress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Ingress
  3: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.egress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-egress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Egress
  4: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: ingress.grafana.sources.ingress-gateway
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-ingress-gateway-to-grafana
      namespace: example
    spec:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: gateway
          ports:
            - port: 3000
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/name: grafana
      policyTypes:
        - Ingress
  5: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: ingress.grafana.sources.monitoring
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-monitoring-to-grafana
      namespace: example
    spec:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: prometheus
              podSelector:
                matchLabels:
                  app.kubernetes.io/name: prometheus
          ports:
            - port: 3000
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/name: grafana
      policyTypes:
        - Ingress
  6: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: egress.grafana.destinations.postgres
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-egress-from-grafana-to-postgres
      namespace: example
    spec:
      egress:
        - ports:
            - port: 5432
              protocol: TCP
          to:
            - ipBlock:
                cidr: 10.0.0.0/8
            - ipBlock:
                cidr: 172.16.0.0/12
            - ipBlock:
                cidr: 192.168.0.0/16
      podSelector:
        matchLabels:
          app.kubernetes.io/name: grafana
      policyTypes:
        - Egress
  7: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: egress.grafana.destinations.sso
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-egress-from-grafana-to-sso
      namespace: example
    spec:
      egress:
        - ports:
            - port: 443
              protocol: TCP
            - port: 8443
              protocol: TCP
          to:
            - ipBlock:
                cidr: 10.0.0.0/8
            - ipBlock:
                cidr: 172.16.0.0/12
            - ipBlock:
                cidr: 192.168.0.0/16
      podSelector:
        matchLabels:
          app.kubernetes.io/name: grafana
      policyTypes:
        - Egress
  8: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: allowDNS
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-egress-from-all-to-dns
      namespace: example
    spec:
      egress:
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
          to:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: kube-system
              podSelector:
                matchLabels:
                  k8s-app: kube-dns
      podSelector: {}
      policyTypes:
        - Egress
  9: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: allowSameNamespace
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-same-namespace
      namespace: example
    spec:
      egress:
        - to:
            - podSelector: {}
      ingress:
        - from:
            - podSelector: {}
      podSelector: {}
      policyTypes:
        - Ingress
        - Egress
identity:
  1: |
    apiVersion: policy.posture.dev/v1alpha1
    kind: PolicyExceptions
    metadata:
      annotations:
        posture.dev/rule: exceptions
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: posture-exceptions
      namespace: example
    spec:
      exceptions: []
  2: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        posture.dev/rule: authorization.enabled
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-ingress
      namespace: example
    spec: {}
  3: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        posture.dev/rule: ingress.api.from.web
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-web-to-api
      namespace: example
    spec:
      action: ALLOW
      rules:
        - from:
            - source:
                principals:
                  - cluster.local/ns/example/sa/web
          to:
            - operation:
                ports:
                  - "8080"
      selector:
        matchLabels:
          app.kubernetes.io/name: api
  4: |
    apiVersion: security.istio.io/v1
    kind: PeerAuthentication
    metadata:
      annotations:
        posture.dev/rule: mtls.mode
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: mtls-strict
      namespace: example
    spec:
      mtls:
        mode: STRICT
  5: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: mesh
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-ambient-probes-to-all
      namespace: example
    spec:
      ingress:
        - from:
            - ipBlock:
                cidr: 169.254.7.127/32
      podSelector: {}
      policyTypes:
        - Ingress
  6: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.ingress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-ingress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Ingress
  7: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.egress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-egress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Egress
  8: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: ingress.api.from.web
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-web-to-api
      namespace: example
    spec:
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: web
          ports:
            - port: 8080
              protocol: TCP
            - port: 15008
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/name: api
      policyTypes:
        - Ingress
  9: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: egress.web.to.api
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-egress-from-web-to-api
      namespace: example
    spec:
      egress:
        - ports:
