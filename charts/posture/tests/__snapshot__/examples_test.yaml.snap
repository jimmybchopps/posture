      namespace: example
    spec:
      egress:
        - ports:
            - port: 8080
              protocol: TCP
            - port: 8081
              protocol: TCP
            - port: 15008
              protocol: TCP
          to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: api
      podSelector:
        matchLabels:
          app.kubernetes.io/name: web
      policyTypes:
        - Egress
  14: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: allowDNS
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-egress-from-all-to-dns
      namespace: example
    spec:
      egress:
        - ports:
            - port: 53
              protocol: UDP
            - port: 53
              protocol: TCP
            - port: 15008
              protocol: TCP
          to:
            - namespaceSelector:
