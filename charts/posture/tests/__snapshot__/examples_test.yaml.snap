mtls:
  1: |
    apiVersion: policy.posture.dev/v1alpha1
    kind: PolicyExceptions
    metadata:
      annotations:
        posture.dev/rule: exceptions
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: posture-exceptions
      namespace: example
    spec:
      exceptions: []
  2: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        posture.dev/rule: authorization.enabled
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-ingress
      namespace: example
    spec: {}
  3: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        posture.dev/rule: mtls.exclusions.api
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-plaintext-to-api
      namespace: example
    spec:
      action: ALLOW
      rules:
        - from:
            - source:
                notPrincipals:
                  - '*'
          to:
            - operation:
                ports:
                  - "8081"
      selector:
        matchLabels:
          app.kubernetes.io/name: api
  4: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        posture.dev/rule: ingress.api.from.web
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-web-to-api
      namespace: example
    spec:
      action: ALLOW
      rules:
        - from:
            - source:
                principals:
                  - cluster.local/ns/example/sa/web
          to:
            - operation:
                ports:
                  - "8080"
                  - "8081"
      selector:
        matchLabels:
          app.kubernetes.io/name: api
  5: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        posture.dev/rule: ingress.api.from.x
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-x-to-api
      namespace: example
    spec:
      action: ALLOW
      rules:
        - from:
            - source:
                namespaces:
                  - plain
          to:
            - operation:
                ports:
                  - "8080"
                  - "8081"
      selector:
        matchLabels:
          app.kubernetes.io/name: api
  6: |
    apiVersion: security.istio.io/v1
    kind: PeerAuthentication
    metadata:
      annotations:
        posture.dev/rule: mtls.mode
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: mtls-strict
      namespace: example
    spec:
      mtls:
        mode: STRICT
  7: |
    apiVersion: security.istio.io/v1
    kind: PeerAuthentication
    metadata:
      annotations:
        posture.dev/rule: mtls.exclusions.api
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-plaintext-to-api
      namespace: example
    spec:
      mtls:
        mode: STRICT
      portLevelMtls:
        "8081":
          mode: PERMISSIVE
      selector:
        matchLabels:
          app.kubernetes.io/name: api
  8: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: mesh
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-ambient-probes-to-all
      namespace: example
    spec:
      ingress:
        - from:
            - ipBlock:
                cidr: 169.254.7.127/32
      podSelector: {}
      policyTypes:
        - Ingress
  9: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.ingress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-ingress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Ingress
  10: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: networkPolicy.egress
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: deny-all-egress
      namespace: example
    spec:
      podSelector: {}
      policyTypes:
        - Egress
  11: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      annotations:
        posture.dev/rule: ingress.api.from.web
      labels:
        app.kubernetes.io/instance: posture
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: posture
        helm.sh/chart: posture-0.1.0
      name: allow-ingress-from-web-to-api
      namespace: example
